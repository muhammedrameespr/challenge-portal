# Copy to server/.env and choose values locally. Never commit server/.env.
NODE_ENV=development
PORT=3000
# Built local HTTP demo: http://localhost:3000 (Secure/HSTS follow this protocol).
APP_ORIGIN=http://localhost:5173
PGHOST=localhost
PGPORT=5432
PGDATABASE=challenge_portal
PGUSER=challenge_app
PGPASSWORD=replace_locally
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_random_secret
# Relative paths resolve from server/, never the shell's current directory.
UPLOAD_DIR=./storage
SEED_ADMIN_PASSWORD=choose_a_local_demo_password
SEED_USER1_PASSWORD=choose_a_local_demo_password
SEED_USER2_PASSWORD=choose_a_local_demo_password
# Optional rate limits in milliseconds and request counts.
LOGIN_WINDOW_MS=900000
LOGIN_MAX=10
ANSWER_WINDOW_MS=60000
ANSWER_MAX=20

# Tests use a separate database. Never set this to PGDATABASE.
# TEST_PGHOST=localhost
# TEST_PGPORT=5432
# TEST_PGDATABASE=challenge_portal_test
# TEST_PGUSER=challenge_app_test
# TEST_PGPASSWORD=replace_locally
